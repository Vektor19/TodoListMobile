<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:resources="clr-namespace:TodoListMobile.Resources.Strings"
             xmlns:viewmodels="clr-namespace:TodoListMobile.ViewModels"
             xmlns:models="clr-namespace:TodoListMobile.Models"
             x:Class="TodoListMobile.TodoListPage"
             x:Name="TodoListPageRoot">

    <ContentPage.BindingContext>
        <viewmodels:TodoListPageViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout
            x:Name="MainLayout"
            Style="{StaticResource MainLayoutStyle}">

            <Image
                x:Name="TodoIcon"
                Source="todolist_icon.png"
                Style="{StaticResource TodoIconStyle}" />

            <Label
                x:Name="WelcomeLabel"
                Text="{x:Static resources:AppResources.CurrentTaskHeader}"
                Style="{StaticResource WelcomeLabelStyle}" />

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <CheckBox IsChecked="{Binding HideCompleted}" VerticalOptions="Center" />
                <Label Text="{x:Static resources:AppResources.HideDoneLabel}" VerticalOptions="Center" />
                <Button
                    Text="{x:Static resources:AppResources.ClearAllButton}"
                    Command="{Binding ClearCommand}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <VerticalStackLayout x:Name="FormContainer">
                <CollectionView ItemsSource="{Binding VisibleItems}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TodoItem">
                            <Frame Margin="0,0,0,12" Padding="12">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <CheckBox
                                        Grid.Column="0"
                                        IsChecked="{Binding IsDone}"
                                        VerticalOptions="Center" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Title}"
                                        Style="{StaticResource TaskLabelStyle}"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>

                                    <ImageButton
                                        Grid.Column="2"
                                        Source="edit.svg"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Command="{Binding BindingContext.EditCommand, Source={x:Reference TodoListPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />

                                    <ImageButton
                                        Grid.Column="3"
                                        Source="trash.svg"
                                        Padding="0"
                                        BackgroundColor="Transparent"
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        Command="{Binding BindingContext.DeleteCommand, Source={x:Reference TodoListPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <Button
                x:Name="AddTaskBtn"
                Text="{x:Static resources:AppResources.AddNewTaskButton}"
                Style="{StaticResource AddTaskButtonStyle}"
                Clicked="OnAddNewClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
