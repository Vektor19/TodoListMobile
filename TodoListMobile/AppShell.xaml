<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TodoListMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TodoListMobile"
    xmlns:resources="clr-namespace:TodoListMobile.Resources.Strings"
    Shell.FlyoutBehavior="Disabled"
    Title="{x:Static resources:AppResources.AppTitle}">

    <ShellContent
        Title="{x:Static resources:AppResources.HomeTitle}"
        ContentTemplate="{DataTemplate local:TodoListPage}"
        Route="TodoListPage" />

</Shell>
